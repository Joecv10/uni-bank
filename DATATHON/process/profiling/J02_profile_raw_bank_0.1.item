    <elementParameter field="MEMO_SQL" name="configuration.dataSet.sqlQuery" value="&quot;INSERT INTO db_bank_g3_raw.dq_value_freq&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'job' AS column_name, job AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY job&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'marital' AS column_name, marital AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY marital&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'education' AS column_name, education AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY education&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'credit_default' AS column_name, credit_default AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY credit_default&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'housing' AS column_name, housing AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY housing&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'loan' AS column_name, loan AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY loan&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'contact' AS column_name, contact AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY contact&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'month' AS column_name, month AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY month&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'day_of_week' AS column_name, day_of_week AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY day_of_week&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'poutcome' AS column_name, poutcome AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY poutcome&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'y' AS column_name, y AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY y&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset,&#xA;    'pdays' AS column_name, pdays AS value, COUNT(*) AS freq,&#xA;    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM db_bank_g3_raw.raw_bank_calls), 3) AS pct&#xA;FROM db_bank_g3_raw.raw_bank_calls GROUP BY pdays&quot;"/>
