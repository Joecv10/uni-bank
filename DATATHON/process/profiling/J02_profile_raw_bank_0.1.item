    <elementParameter field="MAPPING_TYPE" name="configuration.dataSet.dataStore.dbMapping" value="mysql_id" show="false"/>
    <elementParameter field="CLOSED_LIST" name="configuration.dataSet.dataStore.snowflakeAuth.authenticationType" value="BASIC" show="false"/>
    <elementParameter field="CLOSED_LIST" name="configuration.dataSet.dataStore.snowflakeAuth.grantType" value="CLIENT_CREDENTIALS" show="false"/>
    <elementParameter field="MEMO_SQL" name="configuration.dataSet.sqlQuery" value="&quot;INSERT INTO db_bank_g3_raw.dq_profile&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'age' AS column_name, 'varchar(8)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN age IS NULL OR TRIM(age) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(age) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT age) AS card,&#xA;             CAST(MIN(CAST(NULLIF(TRIM(age), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mn,&#xA;             CAST(MAX(CAST(NULLIF(TRIM(age), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(age), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT age AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY age ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'job' AS column_name, 'varchar(32)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN job IS NULL OR TRIM(job) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(job) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT job) AS card,&#xA;             MIN(NULLIF(TRIM(job), '')) AS mn,&#xA;             MAX(NULLIF(TRIM(job), '')) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(job), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT job AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY job ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'marital' AS column_name, 'varchar(16)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN marital IS NULL OR TRIM(marital) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(marital) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT marital) AS card,&#xA;             MIN(NULLIF(TRIM(marital), '')) AS mn,&#xA;             MAX(NULLIF(TRIM(marital), '')) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(marital), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT marital AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY marital ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'education' AS column_name, 'varchar(32)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN education IS NULL OR TRIM(education) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(education) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT education) AS card,&#xA;             MIN(NULLIF(TRIM(education), '')) AS mn,&#xA;             MAX(NULLIF(TRIM(education), '')) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(education), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT education AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY education ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'credit_default' AS column_name, 'varchar(16)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN credit_default IS NULL OR TRIM(credit_default) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(credit_default) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT credit_default) AS card,&#xA;             MIN(NULLIF(TRIM(credit_default), '')) AS mn,&#xA;             MAX(NULLIF(TRIM(credit_default), '')) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(credit_default), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT credit_default AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY credit_default ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'housing' AS column_name, 'varchar(16)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN housing IS NULL OR TRIM(housing) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(housing) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT housing) AS card,&#xA;             MIN(NULLIF(TRIM(housing), '')) AS mn,&#xA;             MAX(NULLIF(TRIM(housing), '')) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(housing), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT housing AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY housing ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'loan' AS column_name, 'varchar(16)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN loan IS NULL OR TRIM(loan) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(loan) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT loan) AS card,&#xA;             MIN(NULLIF(TRIM(loan), '')) AS mn,&#xA;             MAX(NULLIF(TRIM(loan), '')) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(loan), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT loan AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY loan ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'contact' AS column_name, 'varchar(16)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN contact IS NULL OR TRIM(contact) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(contact) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT contact) AS card,&#xA;             MIN(NULLIF(TRIM(contact), '')) AS mn,&#xA;             MAX(NULLIF(TRIM(contact), '')) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(contact), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT contact AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY contact ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'month' AS column_name, 'varchar(8)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN month IS NULL OR TRIM(month) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(month) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT month) AS card,&#xA;             MIN(NULLIF(TRIM(month), '')) AS mn,&#xA;             MAX(NULLIF(TRIM(month), '')) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(month), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT month AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY month ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'day_of_week' AS column_name, 'varchar(8)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN day_of_week IS NULL OR TRIM(day_of_week) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(day_of_week) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT day_of_week) AS card,&#xA;             MIN(NULLIF(TRIM(day_of_week), '')) AS mn,&#xA;             MAX(NULLIF(TRIM(day_of_week), '')) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(day_of_week), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT day_of_week AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY day_of_week ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'duration' AS column_name, 'varchar(16)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN duration IS NULL OR TRIM(duration) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(duration) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT duration) AS card,&#xA;             CAST(MIN(CAST(NULLIF(TRIM(duration), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mn,&#xA;             CAST(MAX(CAST(NULLIF(TRIM(duration), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(duration), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT duration AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY duration ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'campaign' AS column_name, 'varchar(8)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN campaign IS NULL OR TRIM(campaign) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(campaign) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT campaign) AS card,&#xA;             CAST(MIN(CAST(NULLIF(TRIM(campaign), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mn,&#xA;             CAST(MAX(CAST(NULLIF(TRIM(campaign), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(campaign), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT campaign AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY campaign ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'pdays' AS column_name, 'varchar(8)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN pdays IS NULL OR TRIM(pdays) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(pdays) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT pdays) AS card,&#xA;             CAST(MIN(CAST(NULLIF(TRIM(pdays), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mn,&#xA;             CAST(MAX(CAST(NULLIF(TRIM(pdays), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(pdays), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT pdays AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY pdays ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'previous' AS column_name, 'varchar(8)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN previous IS NULL OR TRIM(previous) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(previous) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT previous) AS card,&#xA;             CAST(MIN(CAST(NULLIF(TRIM(previous), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mn,&#xA;             CAST(MAX(CAST(NULLIF(TRIM(previous), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(previous), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT previous AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY previous ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'poutcome' AS column_name, 'varchar(16)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN poutcome IS NULL OR TRIM(poutcome) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(poutcome) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT poutcome) AS card,&#xA;             MIN(NULLIF(TRIM(poutcome), '')) AS mn,&#xA;             MAX(NULLIF(TRIM(poutcome), '')) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(poutcome), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT poutcome AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY poutcome ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'emp_var_rate' AS column_name, 'varchar(16)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN emp_var_rate IS NULL OR TRIM(emp_var_rate) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(emp_var_rate) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT emp_var_rate) AS card,&#xA;             CAST(MIN(CAST(NULLIF(TRIM(emp_var_rate), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mn,&#xA;             CAST(MAX(CAST(NULLIF(TRIM(emp_var_rate), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(emp_var_rate), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS JOIN (SELECT emp_var_rate AS v, COUNT(*) AS c FROM db_bank_g3_raw.raw_bank_calls&#xA;            GROUP BY emp_var_rate ORDER BY c DESC, v LIMIT 1) t&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT '&quot; + context.run_id + &quot;' AS run_id, NOW(6) AS run_ts, 'raw_bank_calls' AS dataset, 'cons_price_idx' AS column_name, 'varchar(16)' AS data_type,&#xA;    a.n, a.n_null, ROUND(a.n_null * 100.0 / a.n, 3),&#xA;    a.n_unk, ROUND(a.n_unk * 100.0 / a.n, 3),&#xA;    a.card, a.mn, a.mx, a.avg_len,&#xA;    t.v, ROUND(t.c * 100.0 / a.n, 3)&#xA;FROM (SELECT COUNT(*) AS n,&#xA;             SUM(CASE WHEN cons_price_idx IS NULL OR TRIM(cons_price_idx) = '' THEN 1 ELSE 0 END) AS n_null,&#xA;             SUM(CASE WHEN TRIM(cons_price_idx) = 'unknown' THEN 1 ELSE 0 END) AS n_unk,&#xA;             COUNT(DISTINCT cons_price_idx) AS card,&#xA;             CAST(MIN(CAST(NULLIF(TRIM(cons_price_idx), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mn,&#xA;             CAST(MAX(CAST(NULLIF(TRIM(cons_price_idx), '') AS DECIMAL(14,4))) AS CHAR(64)) AS mx,&#xA;             ROUND(AVG(LENGTH(NULLIF(TRIM(cons_price_idx), ''))), 2) AS avg_len&#xA;      FROM db_bank_g3_raw.raw_bank_calls) a&#xA;CROSS J