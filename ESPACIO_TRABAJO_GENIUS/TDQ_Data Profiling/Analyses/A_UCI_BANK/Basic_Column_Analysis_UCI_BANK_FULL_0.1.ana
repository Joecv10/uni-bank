        <builtInIndicatorDefinition xmi:id="_ZYLd8NhzEfGYDKHwOCnAyQ" name="Null Count" label="Null Count">
          <taggedValue xmi:id="_ZYLd8dhzEfGYDKHwOCnAyQ" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_ZYLd8thzEfGYDKHwOCnAyQ" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_ZYLd89hzEfGYDKHwOCnAyQ" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
