          <taggedValue xmi:id="_ZVZ2wdhzEfGYDKHwOCnAyQ" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_ZVZ2wthzEfGYDKHwOCnAyQ" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_ZVZ2w9hzEfGYDKHwOCnAyQ" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
