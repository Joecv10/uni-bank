      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_XOq0M9hzEfGYDKHwOCnAyQ" count="45211" computed="true" distinctValueCount="31">
        <parameters xmi:id="_XOq0NNhzEfGYDKHwOCnAyQ"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../../metadata/fileDelimited/FILE_UCI_BANK/bank_full_0.1.item#_hQo57NhxEfGYDKHwOCnAyQ"/>
