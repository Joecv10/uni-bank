          <taggedValue xmi:id="_ZVQs0thzEfGYDKHwOCnAyQ" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_ZVQs09hzEfGYDKHwOCnAyQ" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_XOqz2thzEfGYDKHwOCnAyQ" count="45211" computed="true">
