      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_XOqz79hzEfGYDKHwOCnAyQ" count="45211" computed="true" distinctValueCount="7168">
        <parameters xmi:id="_XOqz8NhzEfGYDKHwOCnAyQ"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../../metadata/fileDelimited/FILE_UCI_BANK/bank_full_0.1.item#_hQo56NhxEfGYDKHwOCnAyQ"/>
