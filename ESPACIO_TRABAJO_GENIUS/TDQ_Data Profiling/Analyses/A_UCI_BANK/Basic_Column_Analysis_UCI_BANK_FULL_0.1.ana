          <taggedValue xmi:id="_ZYEJMthzEfGYDKHwOCnAyQ" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_ZYEJM9hzEfGYDKHwOCnAyQ" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
