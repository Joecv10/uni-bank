      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_SgDnTdoJEfG47KHYMAiQ8Q" count="41188" computed="true" distinctValueCount="3">
        <parameters xmi:id="_SgDnTtoJEfG47KHYMAiQ8Q"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../../metadata/fileDelimited/FILE_UCI_BANK/bank_full_additional_0.1.item#_oiK5FNi5EfGQOsO7K17S2w"/>
