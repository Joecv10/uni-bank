          <taggedValue xmi:id="_S3-X0toJEfG47KHYMAiQ8Q" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_S3-X09oJEfG47KHYMAiQ8Q" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
