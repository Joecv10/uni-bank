          <taggedValue xmi:id="_S30m0toJEfG47KHYMAiQ8Q" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_S30m09oJEfG47KHYMAiQ8Q" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
