    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO fact_calls_aine (&#xD;&#xA;    client_key,&#xD;&#xA;    campaign_key,&#xD;&#xA;    day,&#xD;&#xA;    duration,&#xD;&#xA;    subscribed&#xD;&#xA;)&#xD;&#xA;SELECT&#xD;&#xA;    dc.client_key,&#xD;&#xA;    dca.campaign_key,&#xD;&#xA;    b.day,&#xD;&#xA;    b.duration,&#xD;&#xA;    b.y&#xD;&#xA;FROM bank_OK_aine b&#xD;&#xA;INNER JOIN dim_client_aine dc&#xD;&#xA;    ON dc.age = b.age&#xD;&#xA;    AND dc.job = b.job&#xD;&#xA;    AND dc.marital = b.marital&#xD;&#xA;    AND dc.education = b.education&#xD;&#xA;    AND dc.default_status = b.has_credit_default&#xD;&#xA;    AND dc.balance = b.balance&#xD;&#xA;    AND dc.housing = b.housing&#xD;&#xA;    AND dc.loan = b.loan&#xD;&#xA;INNER JOIN dim_campaign_aine dca&#xD;&#xA;    ON dca.contact = b.contact&#xD;&#xA;    AND dca.month = b.month&#xD;&#xA;    AND dca.campaign = b.campaign&#xD;&#xA;    AND dca.pdays = b.pdays&#xD;&#xA;    AND dca.previous = b.previous&#xD;&#xA;    AND dca.poutcome = b.poutcome;&quot;"/>
