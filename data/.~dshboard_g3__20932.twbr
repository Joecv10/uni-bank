      <column caption='Age group' datatype='string' name='[Calculation_4450063134978054]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([age] / 10) * 10) + &quot;–&quot; + STR(INT([age] / 10) * 10 + 9)' />
