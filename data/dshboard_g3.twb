      </column>
      <column caption='Subscription rate' datatype='real' default-format='p0.0%' name='[Calculation_4450063077896192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IIF([subscribed] = &quot;yes&quot;, 1, 0))' />
      </column>
      <column caption='Call group' datatype='string' name='[Calculation_4450063082463233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [decil] &gt;= 9 THEN &quot;Top 20%&quot; ELSE &quot;Rest&quot; END' />
        <aliases>
          <alias key='&quot;Rest&quot;' value='Resto' />
          <alias key='&quot;Top 20\%&quot;' value='En la lista' />
        </aliases>
      </column>
      <column caption='% subscribers captured' datatype='real' default-format='p0%' name='[Calculation_4450063128817666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subscribed] = &quot;yes&quot; AND [Calculation_4450063082463233] = &quot;Top 20%&quot;, 1, 0))&#10;/ SUM(IIF([subscribed] = &quot;yes&quot;, 1, 0))' />
      </column>
      <column caption='Lift' datatype='real' default-format='n#,##0.0&quot;x&quot;;-#,##0.0&quot;x&quot;' name='[Calculation_4450063129030659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM(IIF([subscribed] = &quot;yes&quot; AND [Calculation_4450063082463233] = &quot;Top 20%&quot;, 1, 0))&#10;  / SUM(IIF([Calculation_4450063082463233] = &quot;Top 20%&quot;, 1, 0)) )&#10;/ [Calculation_4450063077896192]' />
      </column>
      <column caption='Call list size' datatype='integer' name='[Calculation_4450063129419780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_4450063082463233] = &quot;Top 20%&quot;, 1, 0))' />
      </column>
      <column caption='F1 (test set)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4450063129501701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.52' />
      </column>
      <column caption='Age group' datatype='string' name='[Calculation_4450063134978054]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([age] / 10) * 10) + &quot;–&quot; + STR(INT([age] / 10) * 10 + 9)' />
      </column>
      <column caption='Profile value' datatype='string' name='[Calculation_4450063135887368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4450063135358983]&#10;WHEN &quot;Job&quot;            THEN [job]&#10;WHEN &quot;Age group&quot;      THEN [Calculation_4450063134978054]&#10;WHEN &quot;Education&quot;      THEN [education]&#10;WHEN &quot;Marital status&quot; THEN [marital]&#10;WHEN &quot;Housing loan&quot;   THEN [housing]&#10;WHEN &quot;Personal loan&quot;  THEN [loan]&#10;END' />
      </column>
      <column caption='#' datatype='integer' name='[Calculation_4450063142162441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([score]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% en la lista' datatype='real' default-format='p0%' name='[Calculation_4450063213551629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_4450063135887368] : SUM(IIF([Calculation_4450063082463233] = &quot;Top 20%&quot;, 1, 0)) / COUNT([call_key]) }' />
      </column>
      <column caption='Etiqueta lista' datatype='real' default-format='p0%' name='[Calculation_4450063214403600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4450063082463233] = &quot;Top 20%&quot; THEN [Calculation_4450063213551629] END' />
      </column>
