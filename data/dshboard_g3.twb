            <run fontcolor='#555555' fontsize='10'>   Barra = clientes del grupo · oscuro = en la lista · % = parte del grupo en la lista</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mart_fact_calls_g3+ (DSADEV)' name='federated.0dplblo1l59b0k1h9tt770fu0siy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Grupo de edad' caption='Profile' datatype='string' name='[Parameter 4450063135358983]' param-domain-type='list' role='measure' type='nominal' value='&quot;Age group&quot;'>
              <calculation class='tableau' formula='&quot;Age group&quot;' />
              <aliases>
                <alias key='&quot;Age group&quot;' value='Grupo de edad' />
                <alias key='&quot;Education&quot;' value='Educación' />
                <alias key='&quot;Housing loan&quot;' value='Préstamo hipotecario' />
                <alias key='&quot;Job&quot;' value='Ocupación' />
                <alias key='&quot;Marital status&quot;' value='Estado civil' />
                <alias key='&quot;Personal loan&quot;' value='Préstamo personal' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dplblo1l59b0k1h9tt770fu0siy'>
            <column caption='Call group' datatype='string' name='[Calculation_4450063082463233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [decil] &gt;= 9 THEN &quot;Top 20%&quot; ELSE &quot;Rest&quot; END' />
              <aliases>
                <alias key='&quot;Rest&quot;' value='Resto' />
                <alias key='&quot;Top 20\%&quot;' value='En la lista' />
              </aliases>
            </column>
            <column caption='Call list size' datatype='integer' name='[Calculation_4450063129419780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_4450063082463233] = &quot;Top 20%&quot;, 1, 0))' />
            </column>
            <column caption='Age group' datatype='string' name='[Calculation_4450063134978054]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT([age] / 10) * 10) + &quot;–&quot; + STR(INT([age] / 10) * 10 + 9)' />
            </column>
            <column caption='Profile value' datatype='string' name='[Calculation_4450063135887368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4450063135358983]&#10;WHEN &quot;Job&quot;            THEN [job]&#10;WHEN &quot;Age group&quot;      THEN [Calculation_4450063134978054]&#10;WHEN &quot;Education&quot;      THEN [education]&#10;WHEN &quot;Marital status&quot; THEN [marital]&#10;WHEN &quot;Housing loan&quot;   THEN [housing]&#10;WHEN &quot;Personal loan&quot;  THEN [loan]&#10;END' />
            </column>
            <column caption='% en la lista' datatype='real' default-format='p0%' name='[Calculation_4450063213551629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_4450063135887368] : SUM(IIF([Calculation_4450063082463233] = &quot;Top 20%&quot;, 1, 0)) / COUNT([call_key]) }' />
            </column>
            <column caption='Edad' datatype='integer' name='[age]' role='measure' type='quantitative' />
            <column caption='Call Key' datatype='integer' name='[call_key]' role='dimension' type='ordinal' />
            <column-instance column='[call_key]' derivation='Count' name='[cnt:call_key:qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' caption='Decil' datatype='integer' name='[decil]' role='dimension' type='ordinal' />
            <column caption='Education' datatype='string' name='[education]' role='dimension' type='nominal' />
            <column caption='Housing' datatype='string' name='[housing]' role='dimension' type='nominal' />
            <column caption='Ocupación' datatype='string' name='[job]' role='dimension' type='nominal' />
            <column caption='Loan' datatype='string' name='[loan]' role='dimension' type='nominal' />
            <column caption='Marital' datatype='string' name='[marital]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4450063082463233]' derivation='None' name='[none:Calculation_4450063082463233:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4450063135887368]' derivation='None' name='[none:Calculation_4450063135887368:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4450063213551629]' derivation='None' name='[none:Calculation_4450063213551629:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4450063129419780]' derivation='User' name='[usr:Calculation_4450063129419780:qk]' pivot='key' type='quantitative' />
