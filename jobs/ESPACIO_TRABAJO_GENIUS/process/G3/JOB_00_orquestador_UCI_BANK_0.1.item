    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO mart_dim_campaign_g3 (&#xD;&#xA;    contact,&#xD;&#xA;    month,&#xD;&#xA;    day_of_week,&#xD;&#xA;    campaign,&#xD;&#xA;    pdays,&#xD;&#xA;    previous,&#xD;&#xA;    poutcome,&#xD;&#xA;    emp_var_rate,&#xD;&#xA;    cons_price_idx,&#xD;&#xA;    cons_conf_idx,&#xD;&#xA;    euribor3m,&#xD;&#xA;    nr_employed&#xD;&#xA;)&#xD;&#xA;SELECT DISTINCT&#xD;&#xA;    b.contact,&#xD;&#xA;    b.month,&#xD;&#xA;    b.day_of_week,&#xD;&#xA;    b.campaign,&#xD;&#xA;    b.pdays,&#xD;&#xA;    b.previous,&#xD;&#xA;    b.poutcome,&#xD;&#xA;    b.emp_var_rate,&#xD;&#xA;    b.cons_price_idx,&#xD;&#xA;    b.cons_conf_idx,&#xD;&#xA;    b.euribor3m,&#xD;&#xA;    b.nr_employed&#xD;&#xA;FROM stg_bank_OK_g3 b&#xD;&#xA;WHERE NOT EXISTS (&#xD;&#xA;    SELECT 1&#xD;&#xA;    FROM mart_dim_campaign_g3 d&#xD;&#xA;    WHERE d.contact &lt;=> b.contact&#xD;&#xA;      AND d.month &lt;=> b.month&#xD;&#xA;      AND d.day_of_week &lt;=> b.day_of_week&#xD;&#xA;      AND d.campaign &lt;=> b.campaign&#xD;&#xA;      AND d.pdays &lt;=> b.pdays&#xD;&#xA;      AND d.previous &lt;=> b.previous&#xD;&#xA;      AND d.poutcome &lt;=> b.poutcome&#xD;&#xA;      AND d.emp_var_rate &lt;=> b.emp_var_rate&#xD;&#xA;      AND d.cons_price_idx &lt;=> b.cons_price_idx&#xD;&#xA;      AND d.cons_conf_idx &lt;=> b.cons_conf_idx&#xD;&#xA;      AND d.euribor3m &lt;=> b.euribor3m&#xD;&#xA;      AND d.nr_employed &lt;=> b.nr_employed&#xD;&#xA;);&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
